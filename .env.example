ODOO_URL=https://test6017.odoo.com
ODOO_API_KEY=
TELEGRAM_BOT_TOKEN=
# admin chat ID: always allowed, approves /request access requests
TELEGRAM_ADMIN_CHAT_ID=
# comma-separated chat IDs allowed to use the bot (get yours with /whoami)
TELEGRAM_ALLOWED_CHAT_IDS=
# Odoo user that the bot assigns leads/tickets to (default 2 = admin)
ODOO_BOT_USER_ID=2
BOT_POLL_SECONDS=30
BOT_DIGEST_HOUR=9

# Bot state storage: unset = local file tmp/bot-state.json; "odoo" = ir.config_parameter gravity_bot.state (use on Railway).
BOT_STATE_STORE=
